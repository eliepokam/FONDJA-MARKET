# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner le .env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Adresse publique du site (lien des notifications push)
FRONT_URL=
# Fichier du compte de service Firebase. Relatif = depuis le dossier du projet.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Tâches d'arrière-plan (OTP, push). False = exécutées par le serveur web lui-même, sans Redis ni worker.
# True seulement si Redis ET « celery -A config worker --pool=solo » tournent en permanence.
TACHES_VIA_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0

# OTP
OTP_CANAUX=whatsapp,sms
OTP_NUMEROS_DE_TEST=
OTP_CODE_DE_TEST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_CONTENT_VARIABLES=
DEVCODE_SMS_API_KEY=
DEVCODE_SMS_SENDER_ID=FondjaMkt

# Paiements
PAYMENT_PROVIDER=campay
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=

# Médias servis par Django quand DEBUG=False (hébergement ngrok, sans Nginx)
SERVE_MEDIA=False

SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HORAIRES=
